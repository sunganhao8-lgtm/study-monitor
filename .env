# =================================================================
# Study Monitor - 小米摄像头 RTSP 桥接配置
# =================================================================
# 使用方法：
#   1. 填写你的小米账号密码（Miloco登录用）
#   2. 填写摄像头DID（启动后在 Miloco WebUI 里获取）
#   3. docker-compose up -d
# =================================================================

# Miloco WebUI 密码（随便设一个，首次登录用）
MILOCO_PASSWORD=e10adc3949ba59abbe56e057f20f883e

# Miloco 端口（默认8000）
MILOCO_PORT=8000

# 摄像头 DID（设备ID）
# ⚠️ 先留空，启动 Miloco 后在 WebUI 里获取
CAMERA_ID=1213560681

# RTSP 推流地址（Go2rtc 会提供这个服务）
# 端口8554是Go2rtc的RTSP端口，stream1是流名称
RTSP_URL=rtsp://localhost:8554/stream1

# 视频编码格式：hevc(H.265) 或 h264
# 小米智能摄像机4双摄版 默认 HEVC
VIDEO_CODEC=hevc

# 流通道：0=主摄(广角), 1=副摄(长焦)
STREAM_CHANNEL=0

# 时区
TZ=Asia/Shanghai

# Miloco 主机IP（Windows Docker下一般不用改）
MILOCO_HOST_IP=host-gateway
